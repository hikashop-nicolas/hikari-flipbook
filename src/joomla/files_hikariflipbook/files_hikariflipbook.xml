<?xml version="1.0" encoding="utf-8"?>
<extension type="file" method="upgrade">
	<name>FILES_HIKARIFLIPBOOK</name>
	<author>Hikari Software</author>
	<creationDate>2026-08</creationDate>
	<copyright>Copyright (C) 2026 Hikari Software. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later</license>
	<version>0.3.1</version>
	<description>FILES_HIKARIFLIPBOOK_XML_DESCRIPTION</description>
	<!-- The viewer itself, shared by every extension in the package rather than
	     shipped once per extension: the PDF engine alone is a couple of megabytes.
	     A file extension installs through fileset rather than media, and Joomla's
	     installer warns on a file extension that has no fileset at all. -->
	<fileset>
		<files folder="media" target="media/hikariflipbook">
			<folder>js</folder>
			<folder>css</folder>
			<folder>sounds</folder>
		</files>
	</fileset>
</extension>
