<?xml version="1.0" encoding="utf-8"?>
<extension type="package" method="upgrade">
	<name>Hikari Flipbook</name>
	<packagename>hikariflipbook</packagename>
	<author>Hikari Software</author>
	<creationDate>2026-08</creationDate>
	<copyright>Copyright (C) 2026 Hikari Software. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later</license>
	<version>0.3.1</version>
	<description>PKG_HIKARIFLIPBOOK_XML_DESCRIPTION</description>
	<updateservers>
		<server type="extension" name="Hikari Flipbook" priority="1">https://raw.githubusercontent.com/hikashop-nicolas/hikari-flipbook/main/updates/pkg_hikariflipbook.xml</server>
	</updateservers>

	<!-- The installer reads the package's own name and description out of this,
	     and shows the key itself when it is missing. -->
	<languages folder="language">
		<language tag="en-GB">en-GB/pkg_hikariflipbook.sys.ini</language>
	</languages>

	<files folder="packages">
		<file type="file" id="hikariflipbook">files_hikariflipbook.zip</file>
		<file type="component" id="com_hikariflipbook">com_hikariflipbook.zip</file>
		<file type="module" client="site" id="mod_hikariflipbook">mod_hikariflipbook.zip</file>
		<file type="plugin" group="content" id="hikariflipbook">plg_content_hikariflipbook.zip</file>
	</files>
</extension>
