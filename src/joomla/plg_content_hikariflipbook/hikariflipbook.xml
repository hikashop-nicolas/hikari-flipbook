<?xml version="1.0" encoding="utf-8"?>
<extension type="plugin" group="content" method="upgrade">
	<name>PLG_CONTENT_HIKARIFLIPBOOK</name>
	<author>Hikari Software</author>
	<creationDate>2026-08</creationDate>
	<copyright>Copyright (C) 2026 Hikari Software. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later</license>
	<version>0.3.0</version>
	<description>PLG_CONTENT_HIKARIFLIPBOOK_XML_DESCRIPTION</description>
	<files>
		<filename plugin="hikariflipbook">hikariflipbook.php</filename>
		<folder>lib</folder>
		<folder>language</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic" label="PLG_CONTENT_HIKARIFLIPBOOK_FIELDSET_DEFAULTS"
				description="PLG_CONTENT_HIKARIFLIPBOOK_FIELDSET_DEFAULTS_DESC">
				<field name="book" type="sql" label="MOD_HIKARIFLIPBOOK_BOOK_LABEL"
					description="MOD_HIKARIFLIPBOOK_BOOK_DESC"
					query="SELECT id AS value, title AS text FROM #__hikariflipbook_books WHERE published = 1 ORDER BY title"
					key_field="value" value_field="text">
					<option value="0">MOD_HIKARIFLIPBOOK_BOOK_NONE</option>
				</field>
				<field name="bought" type="text" label="MOD_HIKARIFLIPBOOK_BOUGHT_LABEL"
					description="MOD_HIKARIFLIPBOOK_BOUGHT_DESC" />
				<field name="mode" type="list" label="MOD_HIKARIFLIPBOOK_MODE_LABEL" default="auto">
					<option value="auto">MOD_HIKARIFLIPBOOK_MODE_AUTO</option>
					<option value="single">MOD_HIKARIFLIPBOOK_MODE_SINGLE</option>
					<option value="double">MOD_HIKARIFLIPBOOK_MODE_DOUBLE</option>
				</field>
				<field name="showCover" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_SHOWCOVER_LABEL" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="zoom" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_ZOOM_LABEL" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="sound" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_SOUND_LABEL" default="0">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="soundFile" type="filelist" label="MOD_HIKARIFLIPBOOK_SOUNDFILE_LABEL"
					description="MOD_HIKARIFLIPBOOK_SOUNDFILE_DESC"
					directory="media/hikariflipbook/sounds"
					filter="\.(mp3|ogg|wav|m4a|aac|opus)$"
					hide_none="true" hide_default="true" exclude="index.html">
					<option value="">MOD_HIKARIFLIPBOOK_SOUNDFILE_RANDOM</option>
				</field>
				<field name="lightbox" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_LIGHTBOX_LABEL" default="0">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="maxHeight" type="number" label="MOD_HIKARIFLIPBOOK_MAXHEIGHT_LABEL"
					description="MOD_HIKARIFLIPBOOK_MAXHEIGHT_DESC" default="0" filter="integer" min="0" />
				<field name="seo" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_SEO_LABEL"
					description="MOD_HIKARIFLIPBOOK_SEO_DESC" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="analytics" type="list" label="MOD_HIKARIFLIPBOOK_ANALYTICS_LABEL"
					description="MOD_HIKARIFLIPBOOK_ANALYTICS_DESC" default="">
					<option value="">MOD_HIKARIFLIPBOOK_ANALYTICS_NONE</option>
					<option value="dataLayer">MOD_HIKARIFLIPBOOK_ANALYTICS_DATALAYER</option>
					<option value="gtag">MOD_HIKARIFLIPBOOK_ANALYTICS_GTAG</option>
				</field>
			</fieldset>
		</fields>
	</config>
</extension>
