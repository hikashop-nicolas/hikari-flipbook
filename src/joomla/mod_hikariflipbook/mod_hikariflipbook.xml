<?xml version="1.0" encoding="utf-8"?>
<extension type="module" client="site" method="upgrade">
	<name>MOD_HIKARIFLIPBOOK</name>
	<author>Hikari Software</author>
	<creationDate>2026-08</creationDate>
	<copyright>Copyright (C) 2026 Hikari Software. All rights reserved.</copyright>
	<license>GNU General Public License version 3 or later</license>
	<version>0.2.0</version>
	<description>MOD_HIKARIFLIPBOOK_XML_DESCRIPTION</description>
	<files>
		<filename module="mod_hikariflipbook">mod_hikariflipbook.php</filename>
		<filename>helper.php</filename>
		<folder>lib</folder>
		<folder>tmpl</folder>
		<folder>language</folder>
	</files>
	<config>
		<fields name="params">
			<fieldset name="basic">
				<field name="book" type="sql" label="MOD_HIKARIFLIPBOOK_BOOK_LABEL"
					description="MOD_HIKARIFLIPBOOK_BOOK_DESC"
					query="SELECT id AS value, title AS text FROM #__hikariflipbook_books WHERE published = 1 ORDER BY title"
					key_field="value" value_field="text">
					<option value="0">MOD_HIKARIFLIPBOOK_BOOK_NONE</option>
				</field>
				<field name="path" type="text" label="MOD_HIKARIFLIPBOOK_PATH_LABEL"
					description="MOD_HIKARIFLIPBOOK_PATH_DESC" />
				<field name="bought" type="text" label="MOD_HIKARIFLIPBOOK_BOUGHT_LABEL"
					description="MOD_HIKARIFLIPBOOK_BOUGHT_DESC" />
				<field name="mode" type="list" label="MOD_HIKARIFLIPBOOK_MODE_LABEL" default="auto">
					<option value="auto">MOD_HIKARIFLIPBOOK_MODE_AUTO</option>
					<option value="single">MOD_HIKARIFLIPBOOK_MODE_SINGLE</option>
					<option value="double">MOD_HIKARIFLIPBOOK_MODE_DOUBLE</option>
				</field>
				<field name="showCover" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_SHOWCOVER_LABEL" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="hardCovers" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_HARDCOVERS_LABEL" default="0">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="rtl" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_RTL_LABEL" default="0">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="lightbox" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_LIGHTBOX_LABEL" default="0">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="zoom" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_ZOOM_LABEL" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="sound" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_SOUND_LABEL" default="0">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="soundFile" type="filelist" label="MOD_HIKARIFLIPBOOK_SOUNDFILE_LABEL"
					description="MOD_HIKARIFLIPBOOK_SOUNDFILE_DESC"
					directory="media/hikariflipbook/sounds"
					filter="\.(mp3|ogg|wav|m4a|aac|opus)$"
					hide_none="true" hide_default="true" exclude="index.html">
					<option value="">MOD_HIKARIFLIPBOOK_SOUNDFILE_RANDOM</option>
				</field>
				<field name="download" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_DOWNLOAD_LABEL" default="0">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="deepLink" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_DEEPLINK_LABEL" default="0">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="seo" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_SEO_LABEL"
					description="MOD_HIKARIFLIPBOOK_SEO_DESC" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="analytics" type="list" label="MOD_HIKARIFLIPBOOK_ANALYTICS_LABEL"
					description="MOD_HIKARIFLIPBOOK_ANALYTICS_DESC" default="">
					<option value="">MOD_HIKARIFLIPBOOK_ANALYTICS_NONE</option>
					<option value="dataLayer">MOD_HIKARIFLIPBOOK_ANALYTICS_DATALAYER</option>
					<option value="gtag">MOD_HIKARIFLIPBOOK_ANALYTICS_GTAG</option>
				</field>
			</fieldset>
			<fieldset name="appearance" label="MOD_HIKARIFLIPBOOK_FIELDSET_APPEARANCE">
				<field name="barColour" type="color" label="MOD_HIKARIFLIPBOOK_BARCOLOUR_LABEL"
					description="MOD_HIKARIFLIPBOOK_COLOUR_DESC" format="hex" keywords="none" />
				<field name="pageColour" type="color" label="MOD_HIKARIFLIPBOOK_PAGECOLOUR_LABEL"
					description="MOD_HIKARIFLIPBOOK_COLOUR_DESC" format="hex" keywords="none" />
				<field name="maxHeight" type="number" label="MOD_HIKARIFLIPBOOK_MAXHEIGHT_LABEL"
					description="MOD_HIKARIFLIPBOOK_MAXHEIGHT_DESC" default="0" filter="integer" min="0" />
				<field name="breakpoint" type="number" label="MOD_HIKARIFLIPBOOK_BREAKPOINT_LABEL"
					description="MOD_HIKARIFLIPBOOK_BREAKPOINT_DESC" default="700" filter="integer" />
				<field name="flippingTime" type="number" label="MOD_HIKARIFLIPBOOK_FLIPPINGTIME_LABEL"
					default="700" filter="integer" />
			</fieldset>
			<fieldset name="buttons" label="MOD_HIKARIFLIPBOOK_FIELDSET_BUTTONS">
				<field name="toolbar" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_TOOLBAR_LABEL" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="buttonNav" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_BUTTONNAV_LABEL" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="buttonEnds" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_BUTTONENDS_LABEL" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
				<field name="buttonPage" type="radio" layout="joomla.form.field.radio.switcher"
					label="MOD_HIKARIFLIPBOOK_BUTTONPAGE_LABEL" default="1">
					<option value="0">JNO</option>
					<option value="1">JYES</option>
				</field>
			</fieldset>
			<fieldset name="advanced">
				<field name="layout" type="modulelayout" label="JFIELD_ALT_LAYOUT_LABEL" />
				<field name="moduleclass_sfx" type="textarea" label="COM_MODULES_FIELD_MODULECLASS_SFX_LABEL"
					rows="3" validate="CssIdentifier" />
			</fieldset>
		</fields>
	</config>
</extension>
