{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "hikari-flipbook/book",
  "title": "Flipbook",
  "category": "media",
  "icon": "book-alt",
  "description": "Shows a PDF, an EPUB, a Kindle book, a comic archive or a folder of pages as a book with turning pages.",
  "textdomain": "hikari-flipbook",
  "supports": {
    "html": false,
    "align": [
      "wide",
      "full"
    ]
  },
  "attributes": {
    "book": {
      "type": "string",
      "default": ""
    },
    "path": {
      "type": "string",
      "default": ""
    },
    "bought": {
      "type": "string",
      "default": ""
    },
    "mode": {
      "type": "string",
      "default": ""
    },
    "showCover": {
      "type": "string",
      "default": ""
    },
    "sound": {
      "type": "string",
      "default": ""
    },
    "lightbox": {
      "type": "string",
      "default": ""
    },
    "maxHeight": {
      "type": "string",
      "default": ""
    },
    "hotspotsShown": {
      "type": "string",
      "default": ""
    },
    "analytics": {
      "type": "string",
      "default": ""
    },
    "seo": {
      "type": "string",
      "default": ""
    }
  },
  "editorScript": "file:./editor.js"
}
