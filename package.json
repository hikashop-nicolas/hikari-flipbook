{
  "name": "hikari-flipbook",
  "version": "0.3.1",
  "private": true,
  "description": "Free flipbook extension for Joomla and WordPress, built on flipview.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "build": "npm run build:assets && npm run pot && npm run update && npm run build:joomla && npm run build:wordpress",
    "build:joomla": "node build/build-joomla.mjs",
    "build:wordpress": "node build/build-wordpress.mjs",
    "check": "node build/check-structure.mjs",
    "assets": "sh build/render-assets.sh",
    "build:assets": "node build/build-assets.mjs",
    "test": "php tests/CoreTest.php",
    "pot": "node build/make-pot.mjs",
    "update": "node build/update.mjs",
    "version": "node build/stamp-version.mjs && npm run update && npm run pot && git add -A",
    "site": "npm run build:assets && node build/build-site.mjs",
    "site:serve": "npm run site && node build/serve-site.mjs",
    "shots": "node build/shoot-site.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "flipview": "github:hikashop-nicolas/flipview#v0.18.1",
    "pdfjs-dist": "^5.4.149"
  },
  "devDependencies": {
    "archiver": "^7.0.1",
    "esbuild": "^0.25.0",
    "marked": "^18.0.10"
  }
}
